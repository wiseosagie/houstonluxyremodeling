# ---------------------------------------------------------------------------
# Houston Luxury Remodeling — environment variables
# Copy this file to .env.local for local development.
# Never commit real credentials.
# ---------------------------------------------------------------------------

# Production lead storage: Azure Table Storage connection string. Set ONLY
# as an Azure app setting — leave blank locally so development writes to the
# SQLite file below instead of the production table. Server-only.
AZURE_TABLES_CONNECTION_STRING=

# Local lead storage (SQLite file via Node's built-in node:sqlite — no external
# service required; used only when AZURE_TABLES_CONNECTION_STRING is blank).
# Optional — defaults to ./data/leads.db, created automatically on first use. Set to ":memory:" for ephemeral/test runs.
SQLITE_DB_PATH=

# Transactional email (Resend — https://resend.com)
# OPTIONAL. Leads are stored regardless of whether this is
# configured or working — a missing key, or any Resend failure, only skips
# the new-lead notification email and is logged; it never blocks or loses a
# submission. Server-only.
RESEND_API_KEY=
# Verified "from" address once a sending domain is configured in Resend.
# Falls back to Resend's shared onboarding address if left blank.
EMAIL_FROM="Houston Luxury Remodeling <onboarding@resend.dev>"
# Inbox that receives new lead notifications. OPTIONAL — see RESEND_API_KEY.
LEAD_NOTIFICATION_EMAIL=

# Google Analytics 4
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Site URL, used for canonical tags, sitemap.xml and Open Graph metadata.
# Must match the domain verified in Google Search Console exactly (apex, no
# "www" — see the www -> apex redirect in src/middleware.ts).
NEXT_PUBLIC_SITE_URL=https://houstonluxuryremodeling.com

# Google Search Console (HTML tag verification method)
NEXT_PUBLIC_GSC_VERIFICATION=

# Optional. A real, monitored phone number for homeowner inquiries.
# Leave blank until one exists — the site will not display a fabricated
# number, and click-to-call UI/analytics only render when this is set.
NEXT_PUBLIC_CONTACT_PHONE=

# General-inquiries inbox shown on /contact. Defaults to hello@ on the
# project domain — create this inbox with your email/DNS host before launch.
NEXT_PUBLIC_CONTACT_EMAIL=hello@houstonluxuryremodeling.com

# Owner-only lead export (GET /api/leads/export, Authorization: Bearer <token>;
# add ?format=sqlite to download the leads as a SQLite database file).
# OPTIONAL — leave blank and the route returns 404. Server-only; set the real value as an Azure app
# setting, never here.
LEADS_EXPORT_TOKEN=
